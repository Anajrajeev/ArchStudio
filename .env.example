# ============================================================
# ArchStudio Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # backend only — never expose to browser

# ── AI API keys (platform defaults) ──────────────────────
# Used when a user has not configured their own BYOK key.
# At least one of these must be set for the agent to work.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── BYOK encryption ───────────────────────────────────────
# AES-256 key for encrypting user-supplied API keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key requires re-encrypting all stored user keys.
BYOK_ENCRYPTION_KEY=your-fernet-key-here

# ── App settings ──────────────────────────────────────────
APP_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
DEFAULT_OPENAI_MODEL=gpt-4o

# ── Frontend (Vite) ───────────────────────────────────────
# These are prefixed with VITE_ and safe to expose to the browser.
# Do NOT put secret keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:8000
